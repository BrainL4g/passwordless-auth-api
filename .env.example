# ---------------------------------------------------------------------------
# Passwordless Auth API - шаблон переменных окружения
# Скопируйте в .env и поправьте:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- приложение ------------------------------------------------------------
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
# Количество воркеров uvicorn. ВАЖНО: при числе воркеров больше одного хранилище
# challenge обязано быть общим, иначе begin и complete одной церемонии могут
# попасть в разные процессы: WEB_CONCURRENCY=1 вместе с CHALLENGE_STORE=memory,
# либо WEB_CONCURRENCY=4 вместе с CHALLENGE_STORE=redis
# (docker compose --profile redis up).
WEB_CONCURRENCY=1

# --- база данных (имена сервисов из docker compose) -------------------------
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth
POSTGRES_DB=auth
# Используется контейнером API (compose собирает его из переменных выше), а также
# локальными запусками и alembic.
DATABASE_URL=postgresql+psycopg://auth:auth@localhost:5432/auth
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# --- безопасность -----------------------------------------------------------
# Обязательное значение, в коде по умолчания нет. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-development-only-secret-key-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS -------------------------------------------------------------------
# Список через запятую (или JSON-массив). Сюда попадают только веб-оригины.
CORS_ORIGINS=https://localhost:8443,https://localhost:3000
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type

# --- WebAuthn ---------------------------------------------------------------
# RP ID - это домен БЕЗ схемы, порта и пути.
RP_ID=localhost
RP_NAME=Passwordless Auth API
# Веб-оригин для Windows Hello в Edge/Chrome (только HTTPS!), а также
# Android-оригин: android:apk-key-hash:<base64url SHA-256 сертификата подписи>
ALLOWED_ORIGINS=https://localhost:8443,android:apk-key-hash:REPLACE_WITH_BASE64URL_SHA256
WEBAUTHN_TIMEOUT_MS=300000
WEBAUTHN_REQUIRE_USER_VERIFICATION=true
USER_HANDLE_LENGTH=32

# --- challenges -------------------------------------------------------------
CHALLENGE_TTL_SECONDS=300
CHALLENGE_CLEANUP_INTERVAL_SECONDS=60
# memory | redis
CHALLENGE_STORE=memory
REDIS_URL=redis://redis:6379/0

# --- ограничение частоты запросов -------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Android Digital Asset Links -------------------------------------------
ANDROID_PACKAGE_NAME=com.example.passwordless
ANDROID_CERT_FINGERPRINTS=REPLACE_WITH_BASE64URL_SHA256
